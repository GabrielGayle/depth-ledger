# Copy to .env and fill in. Never commit .env.
ARENA_ACCESS_TOKEN=

# Infer backend: local (default) or modal
INFER_BACKEND=local
MODAL_APP_NAME=depth-ledger
# Auth: run `modal setup` (writes ~/.modal.toml) or set:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional overrides for the rough cost ticker (USD per GPU-second)
# MODAL_GPU_RATE_T4=0.000164

# Operator: enable optional NDI live send (requires an NDI Python binding)
# OPERATOR_NDI=1

# Working cache — Are.na holds published plates; local outputs/ is a bounded scratch pad.
# DEPTH_LEDGER_DISK_GB=3
# DEPTH_LEDGER_INFER_CACHE_GB=1.5
# DEPTH_LEDGER_RAM_RUNS=2
# DEPTH_LEDGER_COOK_WORKERS=6
# DEPTH_LEDGER_DOWNLOAD_WORKERS=8
# DEPTH_LEDGER_INFER_WORKERS=1

# Blender MCP / float EXR export
# OPENCV_IO_ENABLE_OPENEXR=1
# BLENDER_MCP_HOST=localhost
# BLENDER_MCP_PORT=9876
# BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# DEPTH_LEDGER_URL=http://127.0.0.1:8000
